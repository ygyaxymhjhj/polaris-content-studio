# DeepSeek official endpoint (no OpenRouter). Set your own server-only key.
# Other OpenAI-compatible endpoints can be configured explicitly if needed.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Optional tuning. Every one of these has a working default.
# Reasoning models scale their thinking to the budget they are given, so the default bounds it.
# One of minimal, low, medium, high, or default to hand the decision back to the provider.
AI_REASONING_EFFORT=default
# Channels generated in parallel within a single request.
AI_CONCURRENCY=6
# Hard cap on reply size. Leave empty unless your provider requires one: with a cap set, a reasoning
# model spends the entire budget thinking and the JSON reply is cut off mid-string.
AI_MAX_OUTPUT_TOKENS=
# Overrides the input context window looked up from the model name.
AI_MAX_CONTEXT=

# Candidate collector is opt-in; WikiFX server access remains unresolved.
ARTICLE_COLLECTOR_V2=false
ARTICLE_CRAWLER_LOCAL_BROWSER=false
# Render public pages only; explicit access denials are never retried with a browser.
ARTICLE_RENDER_BROWSER=true
# Optional system Chrome path on the deployment host
ARTICLE_BROWSER_EXECUTABLE=

# MySQL persistence. Keep credentials server-only. Accounts and sign-in live here, so the app
# cannot be used at all without a database. Dedicated Docker instance on the deployment host;
# local development uses an SSH tunnel. Apply deploy/mysql/init.sql before the first sign-in.
MYSQL_HOST=
MYSQL_PORT=13306
MYSQL_DATABASE=polaris_content_studio
MYSQL_USER=polaris_app
MYSQL_PASSWORD=
# Optional. How long a sign-in stays valid, in days. Defaults to 30.
SESSION_TTL_DAYS=

# Postiz social media management integration
POSTIZ_API_URL=http://localhost:5000
POSTIZ_API_KEY=
# Browser-reachable Postiz address for the "connect a new account" hand-off in the publish dialog.
# The server may reach Postiz via localhost while members browse over the LAN, so set the LAN URL here.
POSTIZ_UI_URL=
